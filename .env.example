# URL base del backend. En desarrollo no hace falta: Vite redirige /api a http://localhost:3000.
# En producción, apunta al backend desplegado, por ejemplo:
# VITE_API_URL=https://mi-backend.com/api
VITE_API_URL=

# Modo demo (solo con npm run dev): entra sin backend con admin / 123456 y datos simulados.
# Para activarlo en tu equipo, crea .env.development.local (git no lo sube) con:
# VITE_MODO_DEMO=true
VITE_MODO_DEMO=
